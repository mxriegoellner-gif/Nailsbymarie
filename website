<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NailArt & Gelnägel Studio | Online Termin buchen</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        rosebrand: {
                            50: '#fdf8f6',
                            100: '#f2e8e5',
                            200: '#e8d5cf',
                            500: '#d98299',
                            600: '#c25e79',
                            700: '#a3425c',
                            900: '#4a1926',
                        }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-rosebrand-50 text-stone-800 font-sans antialiased">
    <header class="bg-white/80 backdrop-blur-md border-b border-rosebrand-100 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 h-20 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-10 h-10 rounded-full bg-rosebrand-500 flex items-center justify-center text-white">
                    <i data-lucide="sparkles" class="w-5 h-5"></i>
                </span>
                <span class="font-bold text-xl text-rosebrand-900">Glamour Nails</span>
            </div>
            <a href="#booking" class="px-4 py-2 bg-rosebrand-500 text-white rounded-xl text-sm font-semibold">Termin Buchen</a>
        </div>
    </header>

    <section class="py-12 px-4 text-center max-w-xl mx-auto">
        <h1 class="text-3xl font-bold text-rosebrand-900 mb-3">Deine Nägel. Dein Statement.</h1>
        <p class="text-stone-600 text-sm mb-6">Buche deinen Wunschtermin für Gelnägel schnell und einfach online.</p>
        <a href="#booking" class="inline-block px-6 py-3 bg-rosebrand-500 text-white font-bold rounded-xl shadow-lg">Jetzt Wunschtermin wählen</a>
    </section>

    <section id="booking" class="max-w-md mx-auto p-6 bg-white rounded-3xl shadow-xl border border-rosebrand-100 my-8">
        <h2 class="text-xl font-bold text-rosebrand-900 mb-4 text-center">Terminvereinbarung</h2>
        <form onsubmit="alert('Vielen Dank! Dein Termin wurde gebucht.'); return false;" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-stone-700 mb-1">Behandlung</label>
                <select class="w-full p-3 border rounded-xl text-sm bg-stone-50">
                    <option>Neuanlage Gelnägel (65 €)</option>
                    <option>Auffüllen Refill (45 €)</option>
                    <option>Gelnägel + Nailart (75 €)</option>
                    <option>Nagelreparatur (10 €)</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-stone-700 mb-1">Datum</label>
                <input type="date" required class="w-full p-3 border rounded-xl text-sm bg-stone-50">
            </div>
            <div>
                <label class="block text-xs font-bold text-stone-700 mb-1">Uhrzeit</label>
                <select class="w-full p-3 border rounded-xl text-sm bg-stone-50">
                    <option>09:00 Uhr</option>
                    <option>10:30 Uhr</option>
                    <option>14:00 Uhr</option>
                    <option>15:30 Uhr</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-stone-700 mb-1">Dein Name *</label>
                <input type="text" placeholder="Vor- und Nachname" required class="w-full p-3 border rounded-xl text-sm bg-stone-50">
            </div>
            <div>
                <label class="block text-xs font-bold text-stone-700 mb-1">E-Mail *</label>
                <input type="email" placeholder="deine@email.de" required class="w-full p-3 border rounded-xl text-sm bg-stone-50">
            </div>
            <div>
                <label class="block text-xs font-bold text-stone-700 mb-1">Telefon *</label>
                <input type="tel" placeholder="0170 1234567" required class="w-full p-3 border rounded-xl text-sm bg-stone-50">
            </div>
            <button type="submit" class="w-full py-3.5 bg-rosebrand-500 text-white font-bold rounded-xl shadow-md">Verbindlich Buchen</button>
        </form>
    </section>

    <script>lucide.createIcons();</script>
</body>
</html>
